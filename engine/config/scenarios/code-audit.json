{
  "_comment": "代码审计场景配置 - 代码审计服务交付专用评审与提交规则",
  "description": "代码审计服务交付场景配置",
  "scenario_id": "code-audit",
  "version": "1.0.0",

  "reviewer_rules": {
    "_comment": "代码审计场景评审规则覆盖 - 代码质量优先",
    "review_types": {
      "technical": {
        "_comment": "技术评审维度权重调整 - 代码质量优先",
        "dimensions": {
          "代码质量": {"weight": 35, "max": 10},
          "架构设计": {"weight": 20, "max": 10},
          "安全性": {"weight": 20, "max": 10},
          "技术栈": {"weight": 15, "max": 10},
          "依赖管理": {"weight": 10, "max": 10}
        }
      }
    },
    "thresholds": {
      "_comment": "代码审计场景阈值覆盖",
      "test_coverage": {
        "_comment": "测试覆盖率阈值(%) - 代码审计要求较高覆盖率",
        "excellent": 85,
        "good": 65,
        "poor": 25
      },
      "text_length": {
        "_comment": "审计描述长度要求",
        "detailed": 80,
        "moderate": 40,
        "brief": 25
      },
      "dependency_count": {
        "_comment": "依赖数量阈值 - 代码审计关注依赖安全",
        "optimal": 8,
        "max_acceptable": 15
      }
    },
    "code_quality_checks": {
      "_comment": "代码审计专属质量检查项",
      "static_analysis": {
        "required": true,
        "tools": ["sonarqube", "eslint", "bandit", "spotbugs"],
        "max_allowed_issues": {
          "blocker": 0,
          "critical": 0,
          "major": 3,
          "minor": 10,
          "info": 50
        }
      },
      "code_complexity": {
        "max_cyclomatic_complexity": 15,
        "max_cognitive_complexity": 20,
        "max_function_length_lines": 50,
        "max_class_length_lines": 300
      },
      "duplication": {
        "max_allowed_duplication_percent": 5,
        "min_block_size_lines": 10
      },
      "naming_conventions": {
        "enforce": true,
        "style_guide": "project_specific"
      }
    },
    "defect_penalty": {
      "_comment": "代码缺陷惩罚规则",
      "severity_curve": {
        "1": 1.0,
        "2": 1.1,
        "3": 1.3,
        "4": 1.6,
        "5+": "2.0 + (n-5) * 0.4"
      }
    }
  },

  "submission_components": {
    "_comment": "代码审计场景提交组件 - 8个默认 + 2个审计专属组件",
    "default_components": [
      "readme",
      "demo_guide",
      "introduction",
      "screenshots_guide",
      "faq",
      "risk_disclosure",
      "trust_statement",
      "bundle_meta"
    ],
    "audit_components": [
      {
        "id": "audit_summary",
        "filename": "audit_summary.md",
        "description": "代码审计总结报告（审计范围 / 方法论 / 问题统计 / 风险概览 / 总体评价）",
        "required_fields": ["audit_scope", "methodology", "issue_statistics", "risk_overview", "overall_assessment"],
        "optional_fields": ["executive_summary", "team_recommendations", "timeline"],
        "output_extension": ".md",
        "priority": 9,
        "mandatory": true
      },
      {
        "id": "vulnerability_list",
        "filename": "vulnerability_list.md",
        "description": "漏洞与问题清单（按严重程度排序的问题列表 / 代码位置 / 修复建议）",
        "required_fields": ["issue_id", "severity", "file_path", "line_number", "description", "recommendation"],
        "optional_fields": ["cwe_id", "cvss_score", "fix_code_snippet"],
        "output_extension": ".md",
        "priority": 10,
        "mandatory": true
      }
    ],
    "total_required_components": 10,
    "consistency_check": {
      "enabled": true,
      "issue_traceability": true,
      "code_line_reference_required": true
    }
  },

  "scenario_thresholds": {
    "_comment": "代码审计场景专属阈值",
    "min_code_quality_score": 6,
    "require_test_coverage": true,
    "false_positive_tolerance": 0.15,
    "test_coverage_requirements": {
      "_comment": "测试覆盖率要求",
      "min_line_coverage_percent": 65,
      "min_branch_coverage_percent": 50,
      "critical_modules_min_coverage_percent": 90
    },
    "audit_depth_requirements": {
      "_comment": "审计深度要求",
      "full_codebase_scan": true,
      "third_party_dependency_audit": true,
      "configuration_file_audit": true,
      "api_security_audit": true
    },
    "pass_criteria": {
      "zero_blocker_issues": true,
      "zero_critical_issues": true,
      "major_issues_max": 5,
      "code_reviewer_approval_required": true,
      "false_positive_review_required": true
    },
    "reporting_requirements": {
      "_comment": "报告要求",
      "include_code_examples": true,
      "include_fix_suggestions": true,
      "include_before_after_comparison": true,
      "prioritize_by_risk": true
    }
  }
}
